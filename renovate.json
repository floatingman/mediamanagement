{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Chicago",
  "schedule": ["before 6am on Monday"],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "kubernetes": {
    "enabled": true,
    "managerFilePatterns": [
      "/^k8s/.*\\.yaml$/"
    ]
  },
  "docker-compose": {
    "managerFilePatterns": [
      "/^compose/.*\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Pin-averse tags in manifests — flag but don't auto-merge anything",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"],
      "automerge": false
    },
    {
      "description": "k8s manifest PRs keep the (k8s) suffix; compose PRs don't",
      "matchFileNames": ["k8s/**"],
      "commitMessageSuffix": " (k8s)"
    },
    {
      "description": "postgres majors need dump/restore, not a tag bump — stop offering 18+",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "recyclarr on the v8 line since 2026-09-22 (guide-backed profile, no include templates) — stay within v8, majors manual",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/recyclarr/recyclarr"],
      "allowedVersions": "/^8\\./"
    },
    {
      "description": "*arr apps run DB migrations on major jumps — always manual review",
      "matchFileNames": ["k8s/media/*.yaml"],
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false,
      "prBodyNotes": ["_Reminder: check the app changelog for DB migration notes before merging; restart one app and check logs before the rest._"]
    },
    {
      "description": "Infrastructure charts — manual, these move the edge",
      "matchFileNames": ["k8s/helm/*.yaml"],
      "automerge": false
    },
    {
      "description": "Digest-pinning for :latest is meaningless churn — disable",
      "matchUpdateTypes": ["digest"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "helm chart versions referenced in INSTALL.md commands",
      "managerFilePatterns": ["/^k8s/INSTALL\\.md$/", "/^TROUBLESHOOTING\\.md$/"],
      "matchStrings": ["helm install \\S+ (?<depName>[^ /]+)/(?<packageName>[^ ]+) .*--version (?<currentValue>[^ ]+)"],
      "datasourceTemplate": "helm"
    }
  ],
  "helmv3": {
    "managerFilePatterns": [
      "/^k8s/helm/.*-values\\.yaml$/"
    ]
  }
}
