# Copy this file to .env and fill in all values before starting the stack.
# cp .env.example .env

# -----------------------------------------------------------------------------
# Global deployment settings (server-specific, NOT secret)
# -----------------------------------------------------------------------------
# Timezone for every service (TZ database name):
#   https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago
# UID/GID that owns appdata + media for the linuxserver-style services.
# Must match the account that owns the files on the host (this server: 1000:1003).
PUID=1000
PGID=1003
# Email Let's Encrypt uses for cert-expiry notices. Set your real address in .env
# (gitignored) — the tracked example keeps a placeholder so your email stays private.
ACME_EMAIL=

# -----------------------------------------------------------------------------
# Cloudflare
# -----------------------------------------------------------------------------
# API token with Zone:DNS:Edit permission for thenewmans.casa
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_DNS_TOKEN=

# -----------------------------------------------------------------------------
# Authelia (SSO / forward-auth gateway)
# -----------------------------------------------------------------------------
# All three values must be unique random strings (minimum 32 characters each)
# Generate with: openssl rand -hex 32
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# ProtonVPN (current VPN provider for gluetun)
# -----------------------------------------------------------------------------
# WireGuard private key from your ProtonVPN account.
# IMPORTANT: generate the config at https://account.proton.me/u/0/vpn/WireGuard
# and ENABLE "NAT-PMP (Port Forwarding)" under Select VPN options before copying
# the PrivateKey — this is what enables incoming port forwarding for qBittorrent.
PROTONVPN_WIREGUARD_PRIVATE_KEY=
# API key securing gluetun's control server; read by the qBittorrent port-sync
# mod (t-anc/GSP). Generate with: openssl rand -base64 36
# Must match the apikey in appdata/gluetun/auth/config.toml.
GLUETUN_API_KEY=

# -----------------------------------------------------------------------------
# Plex (media server)
# -----------------------------------------------------------------------------
# Absolute host path to the Plex data directory (config + DBs + Metadata + the
# ~600G content-addressed Media store). Defaults to the native-install location
# on this server. On a new server, set this to wherever you copied the data.
PLEX_DATA_PATH=/var/lib/plexmediaserver
# UID/GID that owns the Plex data dir. This server's native install ran as
# `plex` (999:996). On a fresh server, set these to match the data's ownership
# (commonly 1000:1003) — then: sudo chown -R $PLEX_PUID:$PLEX_PGID $PLEX_DATA_PATH
PLEX_PUID=999
PLEX_PGID=996
# Claim token — ONLY needed to claim a brand-new server with no migrated data.
# Get one at https://www.plex.tv/claim/ (valid ~4 minutes). Leave blank otherwise.
PLEX_CLAIM=

# -----------------------------------------------------------------------------
# Maintainerr (optional)
# -----------------------------------------------------------------------------
# GitHub Personal Access Token — raises API rate limit from 60 to 5000 req/hr
# Create at: https://github.com/settings/tokens (no scopes required)
MAINTAINERR_GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Linkwarden (bookmark manager)
# -----------------------------------------------------------------------------
# Generate all three with: openssl rand -base64 32
# LINKWARDEN_MEILI_MASTER_KEY only needs to be 16+ characters
LINKWARDEN_DB_PASSWORD=
LINKWARDEN_NEXTAUTH_SECRET=
LINKWARDEN_MEILI_MASTER_KEY=

# nextDash (bookmark dashboard) — write token required on destructive API calls.
# Generate with: openssl rand -hex 32
NEXTDASH_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# ConvertX (convertx)
# -----------------------------------------------------------------------------
# JWT signing secret. Generate with: openssl rand -hex 32
CONVERTX_JWT_SECRET=

# -----------------------------------------------------------------------------
# Zipline (file upload / ShareX server)
# -----------------------------------------------------------------------------
# Generate each with: openssl rand -base64 42 | tr -dc A-Za-z0-9 | cut -c -32
ZIPLINE_DB_PASSWORD=
ZIPLINE_CORE_SECRET=

# -----------------------------------------------------------------------------
# RomM (game library manager)
# -----------------------------------------------------------------------------
# Generate each with: openssl rand -hex 32
ROMM_DB_PASSWORD=
ROMM_DB_ROOT_PASSWORD=
ROMM_AUTH_SECRET_KEY=
# Optional metadata providers — leave blank to keep disabled.
# ScreenScraper account (recommended provider): https://www.screenscraper.fr/
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
# SteamGridDB API key: https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=
# RetroAchievements API key: https://api-docs.retroachievements.org/
RETROACHIEVEMENTS_API_KEY=

# NAS mount roots — bind-mount sources (container-side paths stay literal)
RATCHET_MEDIA=/mnt/ratchetmedia
PERCEPTOR_MEDIA=/mnt/perceptormedia
PERCEPTOR_EXPANSION=/mnt/perceptormediaexpansion
BACKUPS=/mnt/backups
