# Copy this file to .env and fill in all values before starting the stack.
# cp .env.example .env

# -----------------------------------------------------------------------------
# Cloudflare
# -----------------------------------------------------------------------------
# API token with Zone:DNS:Edit permission for thenewmans.casa
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_DNS_TOKEN=

# -----------------------------------------------------------------------------
# Authelia (SSO / forward-auth gateway)
# -----------------------------------------------------------------------------
# All three values must be unique random strings (minimum 32 characters each)
# Generate with: openssl rand -hex 32
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# NordVPN
# -----------------------------------------------------------------------------
# WireGuard private key from your NordVPN account
# Retrieve at: https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/
NORDVPN_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Maintainerr (optional)
# -----------------------------------------------------------------------------
# GitHub Personal Access Token — raises API rate limit from 60 to 5000 req/hr
# Create at: https://github.com/settings/tokens (no scopes required)
MAINTAINERR_GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Linkwarden (bookmark manager)
# -----------------------------------------------------------------------------
# Generate all three with: openssl rand -base64 32
# LINKWARDEN_MEILI_MASTER_KEY only needs to be 16+ characters
LINKWARDEN_DB_PASSWORD=
LINKWARDEN_NEXTAUTH_SECRET=
LINKWARDEN_MEILI_MASTER_KEY=
